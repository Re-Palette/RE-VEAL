# ─────────────────────────────────────────────────────────────────────────────
# Google sign-in (Auth.js v5)
#
# Leave these unset and RE:VEAL runs in demo mode: everything works against the
# seeded profile and the sign-in screen explains what is missing.
#
# To turn on real accounts:
#
#   1. https://console.cloud.google.com/apis/credentials
#      Create credentials -> OAuth client ID -> Web application
#
#   2. Authorised JavaScript origins
#        http://localhost:3000
#        https://<your-domain>
#
#   3. Authorised redirect URIs  (the /api/auth/callback/google path is fixed)
#        http://localhost:3000/api/auth/callback/google
#        https://<your-domain>/api/auth/callback/google
#
#   4. Copy the client ID and secret below.
#
#   5. Generate a session-signing secret:
#        npx auth secret
#      or
#        openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# The app trusts the request host so it runs locally and on any host. If you
# deploy behind a proxy that does not normalise the Host header, pin the URL
# here instead — it takes precedence.
# AUTH_URL=https://your-domain.example
